# ============================================================
# متغیرهای محیطی Hejleh App
# این فایل را به .env.local کپی کرده و مقدارها را پر کنید.
# فایل .env.local هرگز در گیت commit نمی‌شود.
# ============================================================

# ---------- کلاینت (با VITE_ شروع می‌شوند و در باندل مرورگر می‌روند) ----------
# این دو مقدار عمومی هستند و با RLS محافظت می‌شوند.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# آدرس پایه‌ی Supabase Edge Functions (بدون اسلش انتهایی).
# اگر خالی باشد، فرانت‌اند به /api/... همان origin سرور می‌زند.
# روی Vercel این متغیر را تنظیم نکنید (توابع api/* با همان origin سرو می‌شوند).
VITE_API_BASE_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1

# ---------- سرور (هرگز با VITE_ شروع نشوند؛ فقط سمت سرور) ----------
# Supabase → Project Settings → Edge Functions → Secrets
GEMINI_API_KEY=YOUR-GEMINI-API-KEY
GEMINI_MODEL_PRIMARY=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# سقف زمان هر تلاش درخواست به Gemini: ۸ ثانیه
GEMINI_TIMEOUT_MS=8000

# بودجه‌ی کل زمانی زنجیره‌ی AI (مدل اصلی + جایگزین) بر حسب میلی‌ثانیه.
# روی Vercel باید کمتر از maxDuration تابع باشد (vercel.json = ۱۰ ثانیه).
AI_TOTAL_BUDGET_MS=8000

# سقف حجم بدنه‌ی درخواست (بایت) — پیش‌فرض ۴۷۱۸۵۹۲ = ۴.۵ مگابایت،
# هم‌ارز با سقف بدنه‌ی توابع Vercel. درخواست بزرگ‌تر ۴۱۳ می‌گیرد.
MAX_PAYLOAD_BYTES=4718592

# محدودسازی نرخ endpointهای هوش مصنوعی (برای هر کاربر/IP)
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_SECONDS=60

# دامنه‌های مجاز CORS (با کاما جدا کنید؛ خالی = بدون محدودیت)
ALLOWED_ORIGINS=

# ---------- استقرار خودمیزبان سرور Express ----------
PORT=3000
NODE_ENV=production

# ---------- استقرار Vercel (پلن Hobby) ----------
# متغیرهای زمان اجرا در Vercel:
#   GEMINI_API_KEY, GEMINI_MODEL_PRIMARY, GEMINI_MODEL_FALLBACK,
#   GEMINI_TIMEOUT_MS=8000, AI_TOTAL_BUDGET_MS=8000,
#   AI_RATE_LIMIT_MAX, AI_RATE_LIMIT_WINDOW_SECONDS, ALLOWED_ORIGINS
#   (MAX_PAYLOAD_BYTES اختیاری؛ پیش‌فرض سقف ۴.۵ مگابایتی خودکار اعمال می‌شود)
# متغیرهای زمان build در Vercel (در باندل کلاینت می‌روند):
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
#   (VITE_API_BASE_URL را روی Vercel تنظیم نکنید)
# قوانین پلن رایگان رعایت‌شده: سقف بدنه ۴.۵ مگابایت، maxDuration=۱۰ ثانیه،
# حداکثر ۲GB حافظه، ۱۰۰ دیپلوی در روز.

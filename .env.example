# ============================================================
# متغیرهای محیطی Hejleh App
# این فایل را به .env.local کپی کرده و مقدارها را پر کنید.
# فایل .env.local هرگز در گیت commit نمی‌شود.
# ============================================================

# ---------- کلاینت (با VITE_ شروع می‌شوند و در باندل مرورگر می‌روند) ----------
# این دو مقدار عمومی هستند و با RLS محافظت می‌شوند.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# آدرس پایه‌ی Supabase Edge Functions (بدون اسلش انتهایی).
# اگر خالی باشد، فرانت‌اند به /api/... همان origin سرور می‌زند.
VITE_API_BASE_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1

# ---------- سرور (هرگز با VITE_ شروع نشوند؛ فقط سمت سرور) ----------
# Supabase → Project Settings → Edge Functions → Secrets
GEMINI_API_KEY=YOUR-GEMINI-API-KEY
GEMINI_MODEL_PRIMARY=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000

# محدودسازی نرخ endpointهای هوش مصنوعی (برای هر کاربر/IP)
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_SECONDS=60

# دامنه‌های مجاز CORS (با کاما جدا کنید؛ خالی = بدون محدودیت)
ALLOWED_ORIGINS=

# ---------- استقرار خودمیزبان سرور Express ----------
PORT=3000
NODE_ENV=production
